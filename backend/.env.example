# Copy to .env and fill in. .env is gitignored — never commit real values.

DATABASE_URL=postgresql://user:password@host/db?sslmode=require

JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60000

# ── Client Portal concept mockups (AI image generation) ────────────────────
# OFF by default and opt-in on purpose: this is the only feature that spends
# money per anonymous page view (one image call per screen), so a deployment
# that has not set a budget must not start billing just because the code shipped.
# With it off the Estimate page simply omits the section.
MOCKUPS_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high — "low" is the sane default for concept previews; higher
# quality multiplies both cost and file size for no benefit at card size.
OPENAI_IMAGE_QUALITY=low
# Where rendered images are written. Swappable for S3/R2 later via the
# MockupStorage port without touching the schema or routes.
MOCKUP_STORAGE_DIR=storage/mockups
# Spend controls. Screens are billed per image, so this is the main cost lever.
MOCKUP_SCREEN_COUNT=5
MOCKUP_MAX_REGENERATIONS=2
MOCKUP_RATE_LIMIT_PER_HOUR=3
MOCKUP_DAILY_BATCH_BUDGET=50

PORT=5000

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# Admin self-registration is disabled. On startup (and via `npm run db:seed:admin`)
# the app creates this account if no user holds DEFAULT_ADMIN_EMAIL; if one does,
# it does nothing at all. Leave EMAIL/PASSWORD blank and no admin is created —
# there is deliberately no fallback credential baked into the code.
#
# PASSWORD must satisfy the same policy registration enforced: min 8 chars, with
# an uppercase, a lowercase, a number and a special character. Change it after
# the first login; re-running the seed will not overwrite it.
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=
# Optional. Only used when the database has no organization yet — otherwise the
# admin joins the existing one. Defaults to APP_NAME.
DEFAULT_ADMIN_ORGANIZATION=
